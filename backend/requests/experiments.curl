---baseUrl=http://localhost:8080/api/experiments

### Create
curl -iX POST $baseUrl
-H "Content-Type: application/json"
-d
{
  "title": "Experiment 1",
  "workflowId": "e55e6096-3e67-470d-865a-4360961b3254",
  "researcherId": "b89a6c0c-9644-4038-b8af-82025668cd17",
  "startDate": "1970-01-01",
  "parameters": [
    {
      "name": "Parameter 1",
      "measurament": 100,
      "unit": "°C",
      "description": "Temperature of the experiment"
    },
    {
      "name": "Parameter 2",
      "measurament": 8,
      "unit": "mg",
      "description": "Quantity of Substance a"
    }
  ]
}

### Check title availability
---checkName=Experiment%201
curl -iX GET $baseUrl/title-availability?title=$checkName

### Find All
curl -iX GET $baseUrl

### Find By Id
---findUUID=52aa5380-4b20-4b32-a4ea-0e8fc42585e6
curl -iX GET $baseUrl/$findUUID

### Update
---updateUUID=80962f2d-c706-4329-8053-850c66be7f60
curl -iX PUT $baseUrl/$updateUUID
-H "Content-Type: application/json"
-d
{
  "title": "Experiment 2",
  "startDate": "1970-01-01",
  "finishDate": "1970-01-02",
  "result": "Failure",
  "workflowId": "64d92ecd-9e8a-441b-834c-e2db34a3d15c",
  "researcherId": "43e83185-3368-4c86-9e5a-0ec842b01cbb"
}

### Delete
---deleteUUID=97ca1a17-01a0-4d26-8f3b-801e3284844d
curl -iX DELETE $baseUrl/$deleteUUID

### Update parameters
---updateParametersExperimentUUID=6893db42-965e-4ac3-aac2-8373d738db68
curl -iX PUT $baseUrl/$updateParametersExperimentUUID/parameters
-H "Content-Type: application/json"
-d
[
  {
    "id": "a9ea3269-0027-45fe-b92c-a0c3aa59cb03",
    "name": "Parameter 1",
    "measurement": 105,
    "unit": "°C",
    "description": "Temperature of the experiment"
  },
  {
    "id": "277b83f5-c221-464e-b442-1b261ce81db3",
    "name": "Parameter 2",
    "measurement": 10,
    "unit": "Kg",
    "description": "Quantity of Substance x"
  }
]

### Add parameters
---addParameterExperimentUUID=976ade06-1304-4db9-8c5e-d6f2c0018158
curl -iX POST $baseUrl/$addParameterExperimentUUID/parameters
-H "Content-Type: application/json"
-d
{
  "name": "new Parameter",
  "measurament": 3.14,
  "unit": " pies",
  "description": "Pies of the experiment"
}

### Remove parameter
---removeParameterExperimentUUID=dd42583f-6c6e-4072-85d7-9bc0e61464e9
---removeParameterUUID=d45f8ca0-6358-42e4-8b0e-705a73c19618
curl -iX DELETE $baseUrl/$removeParameterExperimentUUID/parameters/$removeParameterUUID

### Advance Status
---advanceStatusExperimentUUID=328086d6-c215-4d4f-a890-0edc513d94be
curl -iX PATCH $baseUrl/$advanceStatusExperimentUUID/advance-status
