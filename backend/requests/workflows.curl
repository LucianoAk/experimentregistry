---baseUrl=http://localhost:8080/api/workflows

### Create
curl -iX POST $baseUrl
-H "Content-Type: application/json"
-d
{
  "statuses": [
    { "name": "Draft" },
    { "name": "In progress" },
    { "name": "Completed" }
  ]
}

### Find All
curl -iX GET $baseUrl

### Find by Id
---findUUID=3abfdbf1-f1bc-46a2-92f0-3e87ad940119
curl -iX GET $baseUrl/$findUUID

### Update Experiment Statuses
---updateStatusesExperimentUUID=433ec45d-797c-46bf-b543-cf8373155f13
curl -iX PUT $baseUrl/$updateStatusesExperimentUUID/statuses
-H "Content-Type: application/json"
-d
[
    {
      "id": "506717ed-79c8-403c-9543-4aaf64161728",
      "name": "Draft",
      "sequenceOrder": 1
    },
    {
      "id": "49aeb79e-fd8c-47ad-b337-a100ab83e4e3",
      "name": "In progress",
      "sequenceOrder": 0
    },
    {
      "id": "0d371d75-fb96-42b0-a096-e6ac4facbcf4",
      "name": "Completed",
      "sequenceOrder": 2
    }
]

### Add Experiment Status
---addStatusExperimentUUID=61a7fcd2-0f9d-4afa-aee7-50d4793d1cb7
---position=0
curl -iX POST $baseUrl/$addStatusExperimentUUID/statuses/$position
-H "Content-Type: application/json"
-d
{
  "name": "TODO"
}

### Delete Experiment Status
---removeStatusExperimentUUID=cb39bece-0d51-4342-8d65-f1d594d775ae
---removeStatusUUID=80f431d1-9731-4fd4-a0e3-b50dd5fb8780
curl -iX DELETE $baseUrl/$removeStatusExperimentUUID/statuses/$removeStatusUUID
