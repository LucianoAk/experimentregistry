  "parameters": [
    {
      "name": "Parameter 1",
      "measurament": 100,
      "unit": "°C",
      "description": "Temperature of the experiment"
    },
    {
      "name": "Parameter 2",
      "measurament": 8,
      "unit": "mg",
      "description": "Quantity of Substance a"
    }
  ]
}

### Check tittle availability
GET {{baseUrl}}/experiment?title=Experiment%201
